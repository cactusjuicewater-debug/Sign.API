{
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/v1/health", "destination": "/api/index?r=health" },
    { "source": "/v1/signatures", "destination": "/api/index?r=signatures" },
    { "source": "/v1/name/:name", "destination": "/api/index?r=name&artist=:name" },
    { "source": "/v1/search", "destination": "/api/index?r=search" },
    { "source": "/assets/:id", "destination": "/api/index?r=asset&id=:id" }
  ]
}
